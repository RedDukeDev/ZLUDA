.version 7.8
.target sm_90
.address_size 64

.visible .entry cvt_rn_satfinite_e4m3x2_f16x2(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .u64                       in_addr;
    .reg .u64                       out_addr;
    .reg .b32                       in;
    .reg .b16                       result;

    ld.param.u64                    in_addr, [input];
    ld.param.u64                    out_addr, [output];

    ld.b32                          in, [in_addr];

    cvt.rn.satfinite.e4m3x2.f16x2   result, in;
    st.b16                          [out_addr], result;
    ret;
}
